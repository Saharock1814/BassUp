#!/bin/bash

# Pre-commit hook for iOS development
# This script runs before each commit to ensure code quality

set -e

echo "🔍 Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Check if we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    print_error "Not in a git repository"
    exit 1
fi

# Get staged Swift files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.swift$')

if [ -z "$STAGED_FILES" ]; then
    print_status "No Swift files staged for commit"
    exit 0
fi

print_status "Found staged Swift files:"
echo "$STAGED_FILES"

# Run SwiftLint on staged files
if command -v swiftlint &> /dev/null; then
    print_status "Running SwiftLint..."
    
    # Create temporary file with staged content
    TEMP_FILE=$(mktemp)
    
    for file in $STAGED_FILES; do
        if [ -f "$file" ]; then
            git show ":$file" >> "$TEMP_FILE"
        fi
    done
    
    # Run SwiftLint on the temporary file
    if swiftlint lint --path "$TEMP_FILE" --config .swiftlint.yml; then
        print_success "SwiftLint passed"
    else
        print_error "SwiftLint found violations. Please fix them before committing."
        rm -f "$TEMP_FILE"
        exit 1
    fi
    
    rm -f "$TEMP_FILE"
else
    print_warning "SwiftLint not found. Skipping linting."
fi

# Check for TODO/FIXME comments
print_status "Checking for TODO/FIXME comments..."
TODO_COUNT=$(git diff --cached | grep -i -E "(TODO|FIXME|HACK|XXX)" | wc -l)

if [ "$TODO_COUNT" -gt 0 ]; then
    print_warning "Found $TODO_COUNT TODO/FIXME comments in staged changes:"
    git diff --cached | grep -i -E "(TODO|FIXME|HACK|XXX)" || true
    echo ""
    print_warning "Consider addressing these before committing."
fi

# Check for large files
print_status "Checking for large files..."
LARGE_FILES=$(git diff --cached --name-only --diff-filter=ACM | xargs -I {} sh -c 'if [ -f "{}" ]; then echo "{}: $(wc -c < "{}")"; fi' | awk '$2 > 1024000 {print $1 ": " $2 " bytes"}')

if [ ! -z "$LARGE_FILES" ]; then
    print_warning "Found large files in staged changes:"
    echo "$LARGE_FILES"
    echo ""
    print_warning "Consider if these large files should be committed."
fi

# Check for merge conflicts
print_status "Checking for merge conflicts..."
if git diff --cached | grep -q "^<<<<<<< \|^=======\|^>>>>>>> "; then
    print_error "Merge conflict markers found in staged changes!"
    exit 1
fi

# Check for trailing whitespace
print_status "Checking for trailing whitespace..."
if git diff --cached | grep -q "^+.*[[:space:]]$"; then
    print_error "Trailing whitespace found in staged changes!"
    print_error "Please remove trailing whitespace before committing."
    exit 1
fi

# Check for empty commits
if git diff --cached --quiet; then
    print_warning "No changes staged for commit"
    exit 1
fi

print_success "All pre-commit checks passed!"
echo ""
print_status "Ready to commit! 🚀"
